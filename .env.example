# Copie usando npm run setup: o script gera CLIENT_SECRET e a chave ES256 locais.
NODE_ENV=development
AUTH_PORT=3001
BFF_PORT=3002
HOST=127.0.0.1
WEB_ORIGIN=http://localhost:5173
AUTH_API_URL=http://localhost:3001
AUTH_ISSUER=http://localhost:3001
CLIENT_ID=demo-web
CLIENT_SECRET=
REDIRECT_URI=http://localhost:5173/auth/callback
CHAIN_IDS=1,11155111
# memory: demonstração de processo único; dados desaparecem ao reiniciar.
# postgres: exige PostgreSQL e npm run db:migrate antes de iniciar.
STORAGE_DRIVER=memory
DATABASE_URL=postgresql://tcc:tcc_local_dev@127.0.0.1:5432/tcc_auth
SIGNING_KEY_FILE=.local/signing-key.json
# O BFF usa cookies Secure para HTTPS; HTTP só é aceito em localhost.
