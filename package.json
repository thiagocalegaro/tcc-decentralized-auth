{
  "name": "ancora-oidc-alternativa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "workspaces": ["core/packages/node-sdk"],
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "dev": "tsx scripts/dev.ts",
    "start": "tsx scripts/dev.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && tsc -p core/packages/node-sdk/tsconfig.build.json && esbuild frontend/hosted-login/main.ts --bundle --format=esm --outfile=frontend/hosted-login/dist/main.js",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:e2e": "npm run build && playwright test",
    "register:client": "tsx scripts/register-client.ts",
    "pack:sdk": "npm run build && npm pack --workspace @ancora/node --pack-destination .local"
  },
  "dependencies": {
    "cookie": "^1.0.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jose": "^6.1.0",
    "oidc-provider": "^9.0.0",
    "viem": "^2.38.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/oidc-provider": "^9.0.0",
    "esbuild": "^0.25.10",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3"
  }
}
