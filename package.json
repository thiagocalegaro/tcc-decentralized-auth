{
  "name": "ancora-tcc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "workspaces": ["frontend/*", "core/apps/*", "core/packages/*"],
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "dev": "tsx scripts/dev.ts",
    "dev:api": "tsx watch core/apps/auth-api/src/main.ts",
    "dev:bff": "tsx watch core/apps/demo-bff/src/main.ts",
    "dev:web": "vite --config frontend/demo-web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build": "tsc --noEmit && vite build --config frontend/demo-web/vite.config.ts",
    "db:migrate": "tsx core/packages/storage/src/migrate.ts",
    "start:api": "tsx core/apps/auth-api/src/main.ts",
    "start:bff": "tsx core/apps/demo-bff/src/main.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.4",
    "@fastify/swagger": "^9.5.1",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.2",
    "jose": "^6.1.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "viem": "^2.38.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "^7.1.9",
    "vitest": "^4.1.11"
  }
}
